# Copy to .env and fill in (values come from infra/deploy.ps1 output). .env is gitignored.

# --- device (python -m device) ---
IOTHUB_HOSTNAME=iot-devctl-xxxxxxxx.azure-devices.net
DEVICE_ID=press-01
X509_CERT_FILE=certs/press-01-cert.pem
X509_KEY_FILE=certs/press-01-key.pem
X509_KEY_PASSPHRASE=

# --- service (iotctl / python -m service) ---
KEY_VAULT_URI=https://kv-devctl-xxxxxxxx.vault.azure.net/
TELEMETRY_SECRET_NAME=iothub-events-connection
CONSUMER_GROUP=iotctl
